#!/usr/bin/env python3
"""setup — wire agent harnesses to ~/.agents

Run once after cloning on a new machine, or to repair drift.
Idempotent: skips anything already correctly symlinked.
MCP: merges mcp/servers.json + mcp/<harness>.servers.json + mcp/secrets.json + mcp/<harness>.secrets.json
     into each harness's native MCP config location.

Usage: setup [--yolo] [claude|kiro|opencode|all]
"""

import argparse
import json
import os
import shutil
import sys
from glob import glob
from pathlib import Path

AGENTS = Path(__file__).resolve().parent
HOME = Path.home()


# --- Utilities ---

def deep_merge(base, override):
    for k, v in override.items():
        if k in base and isinstance(base[k], dict) and isinstance(v, dict):
            deep_merge(base[k], v)
        else:
            base[k] = v


def expand_paths(obj):
    home = str(HOME)
    if isinstance(obj, str):
        return obj.replace('${HOME}', home)
    if isinstance(obj, list):
        return [expand_paths(i) for i in obj]
    if isinstance(obj, dict):
        return {k: expand_paths(v) for k, v in obj.items()}
    return obj


def read_json(path):
    with open(path) as f:
        return json.load(f)


def write_json(path, doc):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        json.dump(doc, f, indent=2)
        f.write('\n')


def load_mcp_servers(harness):
    """Load and merge MCP server layers for a harness."""
    servers = read_json(AGENTS / 'mcp' / 'servers.json')
    for name in [f'{harness}.servers.json', 'secrets.json', f'{harness}.secrets.json']:
        path = AGENTS / 'mcp' / name
        if path.exists():
            for sname, cfg in read_json(path).items():
                servers.setdefault(sname, {})
                deep_merge(servers[sname], cfg)
    return expand_paths(servers)


def link(src, dst):
    """Create a symlink, with safety checks."""
    src, dst = str(src), str(dst)
    agents_str = str(AGENTS)

    # Safety: never write inside the .agents directory itself
    dst_parent = str(Path(dst).parent.resolve())
    if dst.startswith(agents_str) or dst_parent.startswith(agents_str):
        print(f'  SKIP (would write inside .agents): {dst}')
        return

    # Safety: never create a self-referential symlink
    src_real = str(Path(src).resolve())
    dst_real = str(Path(dst_parent) / Path(dst).name)
    if src_real == dst_real:
        print(f'  SKIP (would be self-referential): {dst}')
        return

    if os.path.islink(dst) and os.readlink(dst) == src:
        print(f'  ok  {dst}')
    else:
        if os.path.exists(dst) or os.path.islink(dst):
            if os.path.isdir(dst) and not os.path.islink(dst):
                shutil.rmtree(dst)
            else:
                os.remove(dst)
        os.symlink(src, dst)
        print(f'  linked  {dst} -> {src}')


def prune(directory):
    """Remove symlinks pointing into AGENTS whose target no longer exists."""
    d = Path(directory)
    if not d.is_dir():
        return
    agents_str = str(AGENTS)
    for entry in d.iterdir():
        if entry.is_symlink():
            target = os.readlink(entry)
            if target.startswith(agents_str) and not entry.exists():
                entry.unlink()
                print(f'  pruned  {entry} (target removed)')


def link_skills(dest_dir):
    """Symlink each skills/*/ into dest_dir."""
    os.makedirs(dest_dir, exist_ok=True)
    prune(dest_dir)
    for skill in sorted((AGENTS / 'skills').iterdir()):
        if skill.is_dir():
            link(skill, Path(dest_dir) / skill.name)


def link_context(dest_dir):
    """Symlink each context/*.md into dest_dir."""
    os.makedirs(dest_dir, exist_ok=True)
    for ctx in sorted((AGENTS / 'context').glob('*.md')):
        link(ctx, Path(dest_dir) / ctx.name)


def merge_config(src_path, target_path):
    """Deep merge a JSON config file into an existing target."""
    overrides = read_json(src_path)
    doc = read_json(target_path) if os.path.exists(target_path) else {}
    deep_merge(doc, overrides)
    write_json(target_path, doc)


# --- MCP sync ---

def sync_mcp_claude():
    target = HOME / '.claude.json'
    servers = load_mcp_servers('claude')

    doc = read_json(target) if target.exists() else {}
    existing = doc.get('mcpServers', {})

    def clean(name, cfg):
        result = {k: v for k, v in cfg.items() if k != 'disabled'}
        if 'disabled' in cfg:
            result['disabled'] = cfg['disabled']
        elif name in existing and 'disabled' in existing[name]:
            result['disabled'] = existing[name]['disabled']
        else:
            result['disabled'] = True
        return result

    doc['mcpServers'] = {k: clean(k, v) for k, v in servers.items()}
    write_json(target, doc)
    print(f'  updated  {target} (mcpServers)')


def sync_mcp_kiro():
    target = HOME / '.kiro' / 'settings' / 'mcp.json'
    servers = load_mcp_servers('kiro')

    existing = {}
    if target.exists():
        existing = read_json(target).get('mcpServers', {})

    def clean(name, cfg):
        result = {k: v for k, v in cfg.items() if k != 'disabled'}
        if 'disabled' in cfg:
            result['disabled'] = cfg['disabled']
        elif name in existing:
            result['disabled'] = existing[name].get('disabled', False)
        else:
            result['disabled'] = True
        return result

    doc = {'mcpServers': {k: clean(k, v) for k, v in servers.items()}}
    write_json(target, doc)
    print(f'  updated  {target}')


def sync_mcp_opencode():
    target = HOME / '.config' / 'opencode' / 'opencode.json'
    servers = load_mcp_servers('opencode')

    for name in servers:
        servers[name].setdefault('disabled', True)

    def to_opencode(cfg):
        result = {}
        t = cfg.get('type', 'stdio')
        result['type'] = 'local' if t == 'stdio' else t
        cmd = cfg.get('command', '')
        args = cfg.get('args', [])
        result['command'] = ([cmd] if cmd else []) + args
        env = cfg.get('env', {})
        if env:
            result['environment'] = env
        for k, v in cfg.items():
            if k not in ('type', 'command', 'args', 'env', 'disabled'):
                result[k] = v
        return result

    doc = read_json(target) if target.exists() else {}
    doc['mcp'] = {n: to_opencode(c) for n, c in servers.items() if not c.get('disabled', True)}
    doc['instructions'] = [
        str(AGENTS / 'context' / '*.md'),
        str(AGENTS / 'skills' / '*' / 'SKILL.md'),
    ]
    write_json(target, doc)
    print(f'  updated  {target} (mcp + instructions)')


# --- Yolo ---

def yolo_claude():
    target = HOME / '.claude' / 'settings.json'
    merge_config(AGENTS / 'config' / 'claude' / 'settings.json', target)
    print(f'  yolo  {target} (merged config/claude/settings.json)')


def yolo_kiro():
    src = AGENTS / 'config' / 'kiro' / 'agents' / 'general.json'
    dst = HOME / '.kiro' / 'agents' / 'general.json'
    os.makedirs(dst.parent, exist_ok=True)
    shutil.copy2(src, dst)

    settings = HOME / '.kiro' / 'settings' / 'cli.json'
    doc = read_json(settings) if settings.exists() else {}
    doc['chat.defaultAgent'] = 'general'
    write_json(settings, doc)
    print(f'  yolo  {dst} (allowedTools: ["*"], defaultAgent: general)')


def yolo_opencode():
    target = HOME / '.config' / 'opencode' / 'opencode.json'
    merge_config(AGENTS / 'config' / 'opencode' / 'opencode.json', target)
    print(f'  yolo  {target} (merged config/opencode/opencode.json)')


# --- Harness runners ---

def run_claude(yolo=False):
    print('=== Claude ===')
    for d in [HOME / '.claude' / 'skills', HOME / '.claude' / 'rules']:
        if d.is_symlink() and not d.exists():
            d.unlink()
            print(f'  pruned  {d} (broken symlink)')
    link_skills(HOME / '.claude' / 'skills')
    link_context(HOME / '.claude' / 'rules')
    sync_mcp_claude()
    if yolo:
        yolo_claude()


def run_kiro(yolo=False):
    print('=== Kiro ===')
    for d in [HOME / '.kiro' / 'skills', HOME / '.kiro' / 'steering']:
        if d.is_symlink() and not d.exists():
            d.unlink()
            print(f'  pruned  {d} (broken symlink)')
    link_skills(HOME / '.kiro' / 'skills')
    link_context(HOME / '.kiro' / 'steering')
    sync_mcp_kiro()
    if yolo:
        yolo_kiro()


def run_opencode(yolo=False):
    print('=== OpenCode ===')
    sync_mcp_opencode()
    if yolo:
        yolo_opencode()


# --- Main ---

def ensure_home_symlink():
    home_agents = HOME / '.agents'
    if AGENTS == home_agents:
        return
    if home_agents.is_symlink() and os.readlink(home_agents) == str(AGENTS):
        print(f'~/.agents -> {AGENTS} (ok)')
    elif home_agents.exists():
        print(f'WARNING: {home_agents} already exists and is not a symlink to {AGENTS}. Skipping.')
    else:
        os.symlink(AGENTS, home_agents)
        print(f'~/.agents -> {AGENTS} (linked)')


def ensure_harness_symlinks():
    """Create harnesses/ symlinks to each agent's config directory."""
    harness_dir = AGENTS / 'harnesses'
    os.makedirs(harness_dir, exist_ok=True)
    targets = {
        'claude': (HOME / '.claude', 'claude'),
        'kiro': (HOME / '.kiro', 'kiro-cli'),
        'opencode': (HOME / '.config' / 'opencode', 'opencode'),
    }
    count = 0
    for name, (target, binary) in targets.items():
        dst = harness_dir / name
        if not shutil.which(binary):
            if dst.is_symlink():
                os.remove(dst)
            continue
        target_str = str(target)
        if dst.is_symlink() and os.readlink(str(dst)) == target_str:
            count += 1
        else:
            if dst.exists() or dst.is_symlink():
                os.remove(dst)
            os.symlink(target_str, dst)
            count += 1
    print(f'harnesses/ -> {count} symlinks created')


def main():
    parser = argparse.ArgumentParser(description='Wire agent harnesses to ~/.agents')
    parser.add_argument('harness', nargs='?', default='all',
                        choices=['claude', 'kiro', 'opencode', 'all'])
    parser.add_argument('--yolo', action='store_true',
                        help='Skip permission prompts in all harnesses')
    args = parser.parse_args()

    if args.yolo:
        print('\n⚠️  --yolo will PERSISTENTLY disable permission prompts.')
        print('   All tool use (file writes, shell commands, MCP tools) will')
        print('   be auto-approved in every future session until manually reverted.')
        try:
            answer = input('\n   Continue? [y/N] ')
            if answer.lower() != 'y':
                print('Aborted.')
                sys.exit(0)
            answer = input('   Are you sure? [y/N] ')
            if answer.lower() != 'y':
                print('Aborted.')
                sys.exit(0)
        except (KeyboardInterrupt, EOFError):
            print('\nAborted.')
            sys.exit(1)
        print()

    ensure_home_symlink()
    ensure_harness_symlinks()

    runners = {
        'claude': run_claude,
        'kiro': run_kiro,
        'opencode': run_opencode,
    }

    binaries = {'claude': 'claude', 'kiro': 'kiro-cli', 'opencode': 'opencode'}

    if args.harness == 'all':
        harnesses = [h for h in runners if shutil.which(binaries[h])]
        skipped = [h for h in runners if h not in harnesses]
        if skipped:
            print(f'Skipping (not installed): {", ".join(skipped)}')
    else:
        harnesses = [args.harness]
        if not shutil.which(binaries[args.harness]):
            print(f'WARNING: {args.harness} not found on PATH, running anyway')
    for h in harnesses:
        runners[h](yolo=args.yolo)

    print('\nDone.')


if __name__ == '__main__':
    main()
