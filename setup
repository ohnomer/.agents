#!/usr/bin/env python3
"""setup — wire agent harnesses to ~/.agents

Run once after cloning on a new machine, or to repair drift.
Idempotent: skips anything already correctly symlinked.
MCP: merges mcp/servers.json + mcp/<harness>.servers.json + mcp/secrets.json + mcp/<harness>.secrets.json
     into each harness's native MCP config location.

Usage: setup [--yolo] [claude|kiro|opencode|antigravity|codex|all]
"""

import argparse
import json
import os
import shutil
import sys
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # Python < 3.11
    import tomli as tomllib

AGENTS = Path(__file__).resolve().parent
HOME = Path.home()


# --- Utilities ---

def deep_merge(base, override):
    for k, v in override.items():
        if k in base and isinstance(base[k], dict) and isinstance(v, dict):
            deep_merge(base[k], v)
        else:
            base[k] = v


def expand_paths(obj):
    home = str(HOME)
    if isinstance(obj, str):
        return obj.replace('${HOME}', home)
    if isinstance(obj, list):
        return [expand_paths(i) for i in obj]
    if isinstance(obj, dict):
        return {k: expand_paths(v) for k, v in obj.items()}
    return obj


def read_json(path):
    with open(path) as f:
        return json.load(f)


def write_json(path, doc):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w') as f:
        json.dump(doc, f, indent=2)
        f.write('\n')


def read_toml(path):
    """Read a TOML file into a dict. Returns {} if the file does not exist.

    Codex writes non-standard TOML table headers like [projects./path/to/dir]
    that contain bare slashes. Standard tomllib rejects these. Strip such
    sections before parsing so the rest of the file is still readable.
    """
    path = Path(path)
    if not path.exists() or path.stat().st_size == 0:
        return {}
    raw = path.read_text(encoding='utf-8')
    # Remove any [[...]] or [...] header lines whose key contains a bare /
    # (codex project trust entries). Keep everything else.
    import re as _re
    cleaned = _re.sub(r'^\[{1,2}[^\]]*\/[^\]]*\]{1,2}[ \t]*\n(?:[^\[]*\n)*', '', raw, flags=_re.MULTILINE)
    try:
        return tomllib.loads(cleaned)
    except Exception:
        return {}


def _toml_value(v):
    """Serialise a scalar / list-of-scalars value to its TOML literal form."""
    if isinstance(v, bool):
        return 'true' if v else 'false'
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v)  # JSON string escaping is a valid TOML basic string
    if isinstance(v, list):
        return '[' + ', '.join(_toml_value(i) for i in v) + ']'
    raise TypeError(f'unsupported TOML value type: {type(v)!r}')


def _is_array_of_tables(v):
    return isinstance(v, list) and len(v) > 0 and all(isinstance(i, dict) for i in v)


def _write_toml_lines(doc, prefix, out):
    """Recursively emit TOML lines for a dict.

    Splits keys into scalars/scalar-lists, nested tables (dict), and
    array-of-tables (list of dicts -> repeated [[prefix.key]] blocks).
    """
    scalars = {}
    tables = {}
    array_tables = {}
    for k, v in doc.items():
        if isinstance(v, dict):
            tables[k] = v
        elif _is_array_of_tables(v):
            array_tables[k] = v
        else:
            scalars[k] = v

    if prefix and (scalars or (not tables and not array_tables)):
        out.append(f'[{prefix}]')
    for k, v in scalars.items():
        out.append(f'{k} = {_toml_value(v)}')
    if scalars:
        out.append('')

    for k, v in tables.items():
        table_prefix = f'{prefix}.{k}' if prefix else k
        _write_toml_lines(v, table_prefix, out)

    for k, rows in array_tables.items():
        table_prefix = f'{prefix}.{k}' if prefix else k
        for row in rows:
            out.append(f'[[{table_prefix}]]')
            for rk, rv in row.items():
                out.append(f'{rk} = {_toml_value(rv)}')
            out.append('')


def write_toml(path, doc):
    """Write a dict to a TOML file. Handles the scalar/list/nested-table subset used here.

    Comments in an existing file are not preserved (the file is regenerated).
    Non-standard codex sections (e.g. [projects./path/...]) that contain bare
    slashes are preserved verbatim at the end of the file since standard TOML
    writers cannot round-trip them.
    """
    import re as _re
    os.makedirs(os.path.dirname(path), exist_ok=True)
    # Extract non-standard sections to re-append after writing
    existing = Path(path).read_text(encoding='utf-8') if Path(path).exists() else ''
    nonstandard = _re.findall(r'(?:^|\n)(\[{1,2}[^\]]*\/[^\]]*\]{1,2}[ \t]*\n(?:[^\[]*\n)*)', '\n' + existing, flags=_re.MULTILINE)
    out = []
    _write_toml_lines(doc, '', out)
    text = '\n'.join(out).rstrip('\n') + '\n'
    if nonstandard:
        text += '\n' + ''.join(nonstandard).strip('\n') + '\n'
    with open(path, 'w') as f:
        f.write(text)


def load_mcp_servers(harness):
    """Load and merge MCP server layers for a harness."""
    servers = read_json(AGENTS / 'mcp' / 'servers.json')
    for name in [f'{harness}.servers.json', 'secrets.json', f'{harness}.secrets.json']:
        path = AGENTS / 'mcp' / name
        if path.exists():
            for sname, cfg in read_json(path).items():
                servers.setdefault(sname, {})
                deep_merge(servers[sname], cfg)
    return expand_paths(servers)


def load_kiro_aliases():
    """Read and validate the aliases block from mcp/kiro.servers.json.

    Returns a dict of {"server::tool": "alias_name"} entries, or {} if absent.
    Exits with an error if any entry is malformed.
    """
    path = AGENTS / 'mcp' / 'kiro.servers.json'
    if not path.exists():
        return {}
    data = read_json(path)
    aliases = data.get('aliases')
    if aliases is None:
        return {}
    if not isinstance(aliases, dict):
        print(f'ERROR: aliases in mcp/kiro.servers.json must be an object, got {type(aliases).__name__}')
        sys.exit(1)
    validated = {}
    errors = []
    for key, value in aliases.items():
        if not isinstance(key, str) or not (key.startswith('@') and '/' in key):
            errors.append(f'  invalid key {key!r}: must be in "@server/tool" format')
            continue
        if not isinstance(value, str) or not value.strip():
            errors.append(f'  invalid value for {key!r}: must be a non-empty string')
            continue
        validated[key] = value
    if errors:
        print('ERROR: invalid entries in mcp/kiro.servers.json aliases block:')
        for e in errors:
            print(e)
        sys.exit(1)
    return validated


def link(src, dst):
    """Create a symlink, with safety checks."""
    src, dst = str(src), str(dst)
    agents_str = str(AGENTS)

    # Safety: never write inside the .agents directory itself
    dst_parent = str(Path(dst).parent.resolve())
    if dst.startswith(agents_str) or dst_parent.startswith(agents_str):
        print(f'  SKIP (would write inside .agents): {dst}')
        return

    # Safety: never create a self-referential symlink
    src_real = str(Path(src).resolve())
    dst_real = str(Path(dst_parent) / Path(dst).name)
    if src_real == dst_real:
        print(f'  SKIP (would be self-referential): {dst}')
        return

    if os.path.islink(dst) and os.readlink(dst) == src:
        print(f'  ok  {dst}')
    else:
        if os.path.exists(dst) or os.path.islink(dst):
            if os.path.isdir(dst) and not os.path.islink(dst):
                shutil.rmtree(dst)
            else:
                os.remove(dst)
        os.symlink(src, dst)
        print(f'  linked  {dst} -> {src}')


def prune(directory):
    """Remove symlinks pointing into AGENTS whose target no longer exists."""
    d = Path(directory)
    if not d.is_dir():
        return
    agents_str = str(AGENTS)
    for entry in d.iterdir():
        if entry.is_symlink():
            target = os.readlink(entry)
            if target.startswith(agents_str) and not entry.exists():
                entry.unlink()
                print(f'  pruned  {entry} (target removed)')


def link_skills(dest_dir):
    """Symlink each skills/*/ into dest_dir."""
    os.makedirs(dest_dir, exist_ok=True)
    prune(dest_dir)
    for skill in sorted((AGENTS / 'skills').iterdir()):
        if skill.is_dir():
            link(skill, Path(dest_dir) / skill.name)


def link_context(dest_dir):
    """Symlink each context/*.md into dest_dir."""
    os.makedirs(dest_dir, exist_ok=True)
    for ctx in sorted((AGENTS / 'context').glob('*.md')):
        link(ctx, Path(dest_dir) / ctx.name)


def link_prompts(dest_dir):
    """Symlink prompts/*.md into dest_dir as plain .md files."""
    prompts_dir = AGENTS / 'prompts'
    if not prompts_dir.is_dir():
        return
    os.makedirs(dest_dir, exist_ok=True)
    prune(dest_dir)
    for prompt in sorted(prompts_dir.glob('*.md')):
        dest_name = prompt.name
        dest = Path(dest_dir) / dest_name
        link(prompt, dest)


def merge_config(src_path, target_path):
    """Deep merge a JSON config file into an existing target."""
    overrides = read_json(src_path)
    doc = read_json(target_path) if os.path.exists(target_path) else {}
    deep_merge(doc, overrides)
    write_json(target_path, doc)


# --- MCP sync ---

def sync_mcp_claude():
    target = HOME / '.claude.json'
    servers = load_mcp_servers('claude')

    doc = read_json(target) if target.exists() else {}
    existing = doc.get('mcpServers', {})

    def clean(name, cfg):
        result = {k: v for k, v in cfg.items() if k != 'disabled'}
        if 'disabled' in cfg:
            result['disabled'] = cfg['disabled']
        elif name in existing and 'disabled' in existing[name]:
            result['disabled'] = existing[name]['disabled']
        else:
            result['disabled'] = True
        return result

    doc['mcpServers'] = {k: clean(k, v) for k, v in servers.items()}
    write_json(target, doc)
    print(f'  updated  {target} (mcpServers)')


def sync_mcp_kiro():
    target = HOME / '.kiro' / 'settings' / 'mcp.json'
    servers = load_mcp_servers('kiro')

    existing = {}
    if target.exists():
        existing = read_json(target).get('mcpServers', {})

    def clean(name, cfg):
        result = {k: v for k, v in cfg.items() if k != 'disabled'}
        if 'disabled' in cfg:
            result['disabled'] = cfg['disabled']
        elif name in existing:
            result['disabled'] = existing[name].get('disabled', False)
        else:
            result['disabled'] = True
        return result

    doc = {'mcpServers': {k: clean(k, v) for k, v in servers.items()}}
    write_json(target, doc)
    print(f'  updated  {target}')


def sync_tool_aliases_kiro(aliases):
    """Merge aliases into toolAliases in ~/.kiro/agents/general.json.

    Non-destructive: entries in aliases overwrite matching keys; unmanaged
    keys already in toolAliases are left unchanged. No-op if aliases is empty.
    """
    if not aliases:
        return
    target = HOME / '.kiro' / 'agents' / 'general.json'
    if target.exists():
        doc = read_json(target)
    else:
        # Bootstrap from the template in config/kiro/agents/general.json
        template = AGENTS / 'config' / 'kiro' / 'agents' / 'general.json'
        doc = read_json(template) if template.exists() else {}
    doc.setdefault('toolAliases', {})
    doc['toolAliases'].update(aliases)
    os.makedirs(target.parent, exist_ok=True)
    write_json(target, doc)
    print(f'  updated  {target} (toolAliases: {len(aliases)} entries)')


def sync_mcp_agy():
    target = HOME / '.gemini' / 'config' / 'mcp_config.json'
    servers = load_mcp_servers('antigravity')

    doc = {}
    if target.exists() and target.stat().st_size > 0:
        doc = read_json(target)
    existing = doc.get('mcpServers', {})

    def clean(name, cfg):
        result = {k: v for k, v in cfg.items() if k != 'disabled'}
        if 'disabled' in cfg:
            result['disabled'] = cfg['disabled']
        elif name in existing:
            result['disabled'] = existing[name].get('disabled', False)
        else:
            result['disabled'] = True
        return result

    doc['mcpServers'] = {k: clean(k, v) for k, v in servers.items()}
    write_json(target, doc)
    print(f'  updated  {target}')


def sync_mcp_opencode():
    target = HOME / '.config' / 'opencode' / 'opencode.json'
    servers = load_mcp_servers('opencode')

    for name in servers:
        servers[name].setdefault('disabled', True)

    def to_opencode(cfg):
        result = {}
        t = cfg.get('type', 'stdio')
        result['type'] = 'local' if t == 'stdio' else t
        cmd = cfg.get('command', '')
        args = cfg.get('args', [])
        result['command'] = ([cmd] if cmd else []) + args
        env = cfg.get('env', {})
        if env:
            result['environment'] = env
        for k, v in cfg.items():
            if k not in ('type', 'command', 'args', 'env', 'disabled'):
                result[k] = v
        return result

    doc = read_json(target) if target.exists() else {}
    doc['mcp'] = {n: to_opencode(c) for n, c in servers.items() if not c.get('disabled', True)}
    doc['instructions'] = [
        str(AGENTS / 'context' / '*.md'),
        str(AGENTS / 'skills' / '*' / 'SKILL.md'),
    ]
    write_json(target, doc)
    print(f'  updated  {target} (mcp + instructions)')


def sync_mcp_codex():
    target = HOME / '.codex' / 'config.toml'
    servers = load_mcp_servers('codex')

    doc = read_toml(target)
    existing = doc.get('mcp_servers', {})

    def to_codex(name, cfg):
        result = {}
        if cfg.get('url'):
            result['url'] = cfg['url']
        if cfg.get('command'):
            result['command'] = cfg['command']
        args = cfg.get('args', [])
        if args:
            result['args'] = args
        env = cfg.get('env', {})
        if env:
            result['env'] = env
        # Preserve prior enable/disable state; new servers default to disabled.
        if 'enabled' in cfg:
            result['enabled'] = cfg['enabled']
        elif name in existing and 'enabled' in existing[name]:
            result['enabled'] = existing[name]['enabled']
        else:
            result['enabled'] = False
        return result

    before = json.dumps(existing, sort_keys=True)
    new_servers = {}
    for k, v in servers.items():
        converted = to_codex(k, v)
        # Skip entries with no transport (no command, no url) — env-only overlays
        if not converted.get('command') and not converted.get('url'):
            continue
        new_servers[k] = converted
    doc['mcp_servers'] = new_servers
    after = json.dumps(doc['mcp_servers'], sort_keys=True)

    write_toml(target, doc)
    if before == after and target.exists():
        print(f'  ok  {target}')
    else:
        print(f'  updated  {target}')


# --- Yolo ---

def yolo_claude():
    target = HOME / '.claude' / 'settings.json'
    merge_config(AGENTS / 'config' / 'claude' / 'settings.json', target)
    print(f'  yolo  {target} (merged config/claude/settings.json)')


def yolo_kiro():
    src = AGENTS / 'config' / 'kiro' / 'agents' / 'general.json'
    dst = HOME / '.kiro' / 'agents' / 'general.json'
    os.makedirs(dst.parent, exist_ok=True)
    shutil.copy2(src, dst)

    settings = HOME / '.kiro' / 'settings' / 'cli.json'
    doc = read_json(settings) if settings.exists() else {}
    doc['chat.defaultAgent'] = 'general'
    write_json(settings, doc)
    print(f'  yolo  {dst} (allowedTools: ["*"], defaultAgent: general)')


def yolo_opencode():
    target = HOME / '.config' / 'opencode' / 'opencode.json'
    merge_config(AGENTS / 'config' / 'opencode' / 'opencode.json', target)
    print(f'  yolo  {target} (merged config/opencode/opencode.json)')


def yolo_codex():
    target = HOME / '.codex' / 'config.toml'
    overrides = read_toml(AGENTS / 'config' / 'codex' / 'config.toml')
    doc = read_toml(target)
    deep_merge(doc, overrides)
    write_toml(target, doc)
    print(f'  yolo  {target} (merged config/codex/config.toml)')


# --- Harness runners ---

def run_claude(yolo=False):
    print('=== Claude ===')
    for d in [HOME / '.claude' / 'skills', HOME / '.claude' / 'rules']:
        if d.is_symlink() and not d.exists():
            d.unlink()
            print(f'  pruned  {d} (broken symlink)')
    link_skills(HOME / '.claude' / 'skills')
    link_context(HOME / '.claude' / 'rules')
    link_prompts(HOME / '.claude' / 'commands')
    sync_mcp_claude()
    if yolo:
        yolo_claude()


def run_kiro(yolo=False):
    print('=== Kiro ===')
    for d in [HOME / '.kiro' / 'skills', HOME / '.kiro' / 'steering']:
        if d.is_symlink() and not d.exists():
            d.unlink()
            print(f'  pruned  {d} (broken symlink)')
    link_skills(HOME / '.kiro' / 'skills')
    link_context(HOME / '.kiro' / 'steering')
    link_prompts(HOME / '.kiro' / 'prompts')
    sync_mcp_kiro()
    if yolo:
        yolo_kiro()
    aliases = load_kiro_aliases()
    sync_tool_aliases_kiro(aliases)


def yolo_agy():
    target = HOME / '.gemini' / 'antigravity-cli' / 'settings.json'
    merge_config(AGENTS / 'config' / 'antigravity' / 'settings.json', target)
    print(f'  yolo  {target} (merged config/antigravity/settings.json)')


def run_agy(yolo=False):
    print('=== Agy ===')
    config_dir = HOME / '.gemini' / 'config'
    os.makedirs(config_dir, exist_ok=True)
    # Global Customizations Root is ~/.gemini/config/
    # agy loads AGENTS.md there as global rules
    context_src = AGENTS / 'context' / 'CONTEXT.md'
    if context_src.exists():
        link(context_src, config_dir / 'AGENTS.md')
    # Skills live in ~/.gemini/config/skills/
    link_skills(config_dir / 'skills')
    sync_mcp_agy()
    if yolo:
        yolo_agy()


def run_opencode(yolo=False):
    print('=== OpenCode ===')
    link_prompts(HOME / '.config' / 'opencode' / 'commands')
    sync_mcp_opencode()
    if yolo:
        yolo_opencode()


def sync_skills_codex():
    """Register skills/*/ directories in ~/.codex/config.toml skills.config.

    Codex references skill dirs by path in config.toml rather than scanning a
    directory. Codex's loader silently skips symlinked skill directories, so
    entries must point at the RESOLVED real path of each skill dir.
    """
    target = HOME / '.codex' / 'config.toml'
    doc = read_toml(target)
    skills_section = doc.get('skills', {})
    entries = skills_section.get('config', [])

    # Drop stale entries pointing into ~/.agents/skills/ (any layout) so the
    # list can be rebuilt from the current skills/ directory.
    stale_root = str((AGENTS / 'skills').resolve())
    kept = []
    for entry in entries:
        path = entry.get('path', '') if isinstance(entry, dict) else str(entry)
        if str(Path(path).resolve()).startswith(stale_root + os.sep):
            continue
        kept.append(entry)

    for skill in sorted((AGENTS / 'skills').iterdir()):
        if skill.is_dir():
            kept.append({'path': str(skill.resolve()), 'enabled': True})

    doc.setdefault('skills', {})['config'] = kept
    write_toml(target, doc)
    print(f'  updated  {target} (skills.config: {len(kept)} entries)')


def run_codex(yolo=False):
    print('=== Codex ===')
    config_dir = HOME / '.codex'
    os.makedirs(config_dir, exist_ok=True)
    # Codex reads a single ~/.codex/AGENTS.md as global instructions.
    # Concatenate all context/*.md files (same content Kiro/Claude get via
    # individual symlinks) into one file so nothing is silently dropped.
    context_dir = AGENTS / 'context'
    agents_md = config_dir / 'AGENTS.md'
    parts = []
    for ctx in sorted(context_dir.glob('*.md')):
        parts.append(ctx.read_text())
    if parts:
        agents_md.write_text('\n\n---\n\n'.join(parts))
        print(f'  written  {agents_md} ({len(parts)} context files)')
    sync_skills_codex()
    link_prompts(config_dir / 'commands')
    sync_mcp_codex()
    if yolo:
        yolo_codex()


# --- Main ---

def ensure_home_symlink():
    home_agents = HOME / '.agents'
    if AGENTS == home_agents:
        return
    if home_agents.is_symlink() and os.readlink(home_agents) == str(AGENTS):
        print(f'~/.agents -> {AGENTS} (ok)')
    elif home_agents.exists():
        print(f'WARNING: {home_agents} already exists and is not a symlink to {AGENTS}. Skipping.')
    else:
        os.symlink(AGENTS, home_agents)
        print(f'~/.agents -> {AGENTS} (linked)')


def ensure_harness_symlinks():
    """Create harnesses/ symlinks to each agent's config directory."""
    harness_dir = AGENTS / 'harnesses'
    os.makedirs(harness_dir, exist_ok=True)
    targets = {
        'claude': (HOME / '.claude', 'claude'),
        'kiro': (HOME / '.kiro', 'kiro-cli'),
        'opencode': (HOME / '.config' / 'opencode', 'opencode'),
        'antigravity': (HOME / '.gemini', 'agy'),
        'codex': (HOME / '.codex', 'codex'),
    }
    count = 0
    for name, (target, binary) in targets.items():
        dst = harness_dir / name
        if not shutil.which(binary):
            if dst.is_symlink():
                os.remove(dst)
            continue
        target_str = str(target)
        if dst.is_symlink() and os.readlink(str(dst)) == target_str:
            count += 1
        else:
            if dst.exists() or dst.is_symlink():
                os.remove(dst)
            os.symlink(target_str, dst)
            count += 1
    print(f'harnesses/ -> {count} symlinks created')


def main():
    parser = argparse.ArgumentParser(description='Wire agent harnesses to ~/.agents')
    parser.add_argument('harness', nargs='?', default='all',
                        choices=['claude', 'kiro', 'opencode', 'antigravity', 'codex', 'all'])
    parser.add_argument('--yolo', action='store_true',
                        help='Skip permission prompts in all harnesses')
    args = parser.parse_args()

    if args.yolo:
        print('\n⚠️  --yolo will PERSISTENTLY disable permission prompts.')
        print('   All tool use (file writes, shell commands, MCP tools) will')
        print('   be auto-approved in every future session until manually reverted.')
        try:
            answer = input('\n   Continue? [y/N] ')
            if answer.lower() != 'y':
                print('Aborted.')
                sys.exit(0)
            answer = input('   Are you sure? [y/N] ')
            if answer.lower() != 'y':
                print('Aborted.')
                sys.exit(0)
        except (KeyboardInterrupt, EOFError):
            print('\nAborted.')
            sys.exit(1)
        print()

    ensure_home_symlink()
    ensure_harness_symlinks()

    runners = {
        'claude': run_claude,
        'kiro': run_kiro,
        'opencode': run_opencode,
        'antigravity': run_agy,
        'codex': run_codex,
    }

    binaries = {'claude': 'claude', 'kiro': 'kiro-cli', 'opencode': 'opencode', 'antigravity': 'agy', 'codex': 'codex'}

    if args.harness == 'all':
        harnesses = [h for h in runners if shutil.which(binaries[h])]
        skipped = [h for h in runners if h not in harnesses]
        if skipped:
            print(f'Skipping (not installed): {", ".join(skipped)}')
    else:
        harnesses = [args.harness]
        if not shutil.which(binaries[args.harness]):
            print(f'WARNING: {args.harness} not found on PATH, running anyway')
    for h in harnesses:
        runners[h](yolo=args.yolo)

    print('\nDone.')


if __name__ == '__main__':
    main()
