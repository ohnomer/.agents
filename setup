#!/usr/bin/env bash
# setup.sh — wire agent harnesses to ~/.agents
# Run once after cloning on a new machine, or to repair drift.
# Idempotent: skips anything already correctly symlinked.
# MCP: merges mcp/servers.json + mcp/<agent>.servers.json + mcp/secrets.json + mcp/<agent>.secrets.json
#      into each agent's native MCP config location.

set -euo pipefail

AGENTS="$(cd "$(dirname "$0")" && pwd)"

# Ensure ~/.agents points to this repo (skip if already correct or if repo IS ~/.agents)
HOME_AGENTS="$HOME/.agents"
if [ "$AGENTS" != "$HOME_AGENTS" ]; then
  if [ -L "$HOME_AGENTS" ] && [ "$(readlink "$HOME_AGENTS")" = "$AGENTS" ]; then
    echo "~/.agents -> $AGENTS (ok)"
  else
    [ -e "$HOME_AGENTS" ] && echo "WARNING: $HOME_AGENTS already exists and is not a symlink to $AGENTS. Skipping." || {
      ln -s "$AGENTS" "$HOME_AGENTS"
      echo "~/.agents -> $AGENTS (linked)"
    }
  fi
fi

link() {
  local src="$1" dst="$2"
  # Safety: never write inside the .agents directory itself (resolve symlinks in parent)
  local dst_parent
  dst_parent="$(cd "$(dirname "$dst")" 2>/dev/null && pwd -P || true)"
  if [[ "$dst" == "$AGENTS"* ]] || [[ "$dst_parent" == "$AGENTS"* ]]; then
    echo "  SKIP (would write inside .agents): $dst"
    return
  fi
  # Safety: never create a self-referential symlink
  local src_real dst_real
  src_real="$(cd "$(dirname "$src")" 2>/dev/null && pwd -P)/$(basename "$src")" || true
  dst_real="$dst_parent/$(basename "$dst")"
  if [[ "$src_real" == "$dst_real" ]]; then
    echo "  SKIP (would be self-referential): $dst"
    return
  fi
  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    echo "  ok  $dst"
  else
    [ -e "$dst" ] && rm -rf "$dst"
    ln -s "$src" "$dst"
    echo "  linked  $dst -> $src"
  fi
}

prune() {
  # Remove symlinks in $1 that point into $AGENTS but whose target no longer exists.
  local dir="$1"
  [ -d "$dir" ] || return 0
  for entry in "$dir"/*; do
    [ -L "$entry" ] || continue
    local target
    target="$(readlink "$entry")"
    if [[ "$target" == "$AGENTS"* ]] && [ ! -e "$entry" ]; then
      rm "$entry"
      echo "  pruned  $entry (target removed)"
    fi
  done
}

sync_mcp_claude() {
  # Merges mcp/servers.json + mcp/claude.servers.json + mcp/secrets.json + mcp/claude.secrets.json into ~/.claude.json mcpServers.
  local target="$HOME/.claude.json"
  python3 - "$AGENTS" "$target" <<'PYEOF'
import json, sys, os

def deep_merge(base, override):
    for k, v in override.items():
        if k in base and isinstance(base[k], dict) and isinstance(v, dict):
            deep_merge(base[k], v)
        else:
            base[k] = v

def expand_paths(obj):
    if isinstance(obj, str):
        return obj.replace('${HOME}', os.path.expanduser('~'))
    if isinstance(obj, list):
        return [expand_paths(i) for i in obj]
    if isinstance(obj, dict):
        return {k: expand_paths(v) for k, v in obj.items()}
    return obj

agents, target = sys.argv[1], sys.argv[2]

with open(os.path.join(agents, 'mcp', 'servers.json')) as f:
    servers = json.load(f)

for path in [
    os.path.join(agents, 'mcp', 'claude.servers.json'),
    os.path.join(agents, 'mcp', 'secrets.json'),
    os.path.join(agents, 'mcp', 'claude.secrets.json'),
]:
    if os.path.exists(path):
        with open(path) as f:
            overrides = json.load(f)
        for name, cfg in overrides.items():
            servers.setdefault(name, {})
            deep_merge(servers[name], cfg)

doc = {}
if os.path.exists(target):
    with open(target) as f:
        doc = json.load(f)
existing = doc.get('mcpServers', {})

def clean(name, cfg):
    result = {k: v for k, v in cfg.items() if k != 'disabled'}
    if 'disabled' in cfg:
        result['disabled'] = cfg['disabled']
    elif name in existing and 'disabled' in existing[name]:
        result['disabled'] = existing[name]['disabled']
    else:
        result['disabled'] = True
    return result

servers = expand_paths(servers)
doc['mcpServers'] = {k: clean(k, v) for k, v in servers.items()}

with open(target, 'w') as f:
    json.dump(doc, f, indent=2)
    f.write('\n')
PYEOF
  echo "  updated  $target (mcpServers)"
}

sync_mcp_opencode() {
  # Merges mcp/servers.json + mcp/opencode.servers.json + mcp/secrets.json + mcp/opencode.secrets.json into ~/.config/opencode/opencode.json mcp.
  # Also sets instructions to point at the agents context directory.
  # Transforms canonical format → OpenCode format:
  #   command + args → command array, env → environment, type "stdio" → "local"
  local target="$HOME/.config/opencode/opencode.json"
  python3 - "$AGENTS" "$target" <<'PYEOF'
import json, sys, os

def deep_merge(base, override):
    for k, v in override.items():
        if k in base and isinstance(base[k], dict) and isinstance(v, dict):
            deep_merge(base[k], v)
        else:
            base[k] = v

def expand_paths(obj):
    if isinstance(obj, str):
        return obj.replace('${HOME}', os.path.expanduser('~'))
    if isinstance(obj, list):
        return [expand_paths(i) for i in obj]
    if isinstance(obj, dict):
        return {k: expand_paths(v) for k, v in obj.items()}
    return obj

agents, target = sys.argv[1], sys.argv[2]

with open(os.path.join(agents, 'mcp', 'servers.json')) as f:
    servers = json.load(f)

for path in [
    os.path.join(agents, 'mcp', 'opencode.servers.json'),
    os.path.join(agents, 'mcp', 'secrets.json'),
    os.path.join(agents, 'mcp', 'opencode.secrets.json'),
]:
    if os.path.exists(path):
        with open(path) as f:
            overrides = json.load(f)
        for name, cfg in overrides.items():
            servers.setdefault(name, {})
            deep_merge(servers[name], cfg)

for name in servers:
    servers[name].setdefault('disabled', True)

def to_opencode(cfg):
    result = {}
    t = cfg.get('type', 'stdio')
    result['type'] = 'local' if t == 'stdio' else t
    cmd = cfg.get('command', '')
    args = cfg.get('args', [])
    result['command'] = ([cmd] if cmd else []) + args
    env = cfg.get('env', {})
    if env:
        result['environment'] = env
    for k, v in cfg.items():
        if k not in ('type', 'command', 'args', 'env', 'disabled'):
            result[k] = v
    return result

doc = {}
if os.path.exists(target):
    with open(target) as f:
        doc = json.load(f)

servers = expand_paths(servers)
doc['mcp'] = {name: to_opencode(cfg) for name, cfg in servers.items() if not cfg.get('disabled', True)}

# Upsert agents context and skills into instructions (preserve existing entries)
agents_instructions = [
    os.path.join(agents, 'context', '*.md'),
    os.path.join(agents, 'skills', '*', 'SKILL.md'),
]
existing = doc.get('instructions', [])
for entry in agents_instructions:
    if entry not in existing:
        existing.append(entry)
doc['instructions'] = existing

os.makedirs(os.path.dirname(target), exist_ok=True)
with open(target, 'w') as f:
    json.dump(doc, f, indent=2)
    f.write('\n')
PYEOF
  echo "  updated  $target (mcp + instructions)"
}

sync_mcp_kiro() {
  # Merges mcp/servers.json + mcp/kiro.servers.json + mcp/secrets.json + mcp/kiro.secrets.json into ~/.kiro/settings/mcp.json.
  local target="$HOME/.kiro/settings/mcp.json"
  python3 - "$AGENTS" "$target" <<'PYEOF'
import json, sys, os

def deep_merge(base, override):
    for k, v in override.items():
        if k in base and isinstance(base[k], dict) and isinstance(v, dict):
            deep_merge(base[k], v)
        else:
            base[k] = v

def expand_paths(obj):
    if isinstance(obj, str):
        return obj.replace('${HOME}', os.path.expanduser('~'))
    if isinstance(obj, list):
        return [expand_paths(i) for i in obj]
    if isinstance(obj, dict):
        return {k: expand_paths(v) for k, v in obj.items()}
    return obj

agents, target = sys.argv[1], sys.argv[2]

with open(os.path.join(agents, 'mcp', 'servers.json')) as f:
    servers = json.load(f)

for path in [
    os.path.join(agents, 'mcp', 'kiro.servers.json'),
    os.path.join(agents, 'mcp', 'secrets.json'),
    os.path.join(agents, 'mcp', 'kiro.secrets.json'),
]:
    if os.path.exists(path):
        with open(path) as f:
            overrides = json.load(f)
        for name, cfg in overrides.items():
            servers.setdefault(name, {})
            deep_merge(servers[name], cfg)

existing_kiro = {}
if os.path.exists(target):
    with open(target) as f:
        existing_kiro = json.load(f).get('mcpServers', {})

def clean_kiro(name, cfg):
    result = {k: v for k, v in cfg.items() if k != 'disabled'}
    if 'disabled' in cfg:
        result['disabled'] = cfg['disabled']
    elif name in existing_kiro:
        # Preserve existing state; absent key means enabled (False)
        result['disabled'] = existing_kiro[name].get('disabled', False)
    else:
        result['disabled'] = True
    return result

servers = expand_paths(servers)
doc = {'mcpServers': {k: clean_kiro(k, v) for k, v in servers.items()}}

os.makedirs(os.path.dirname(target), exist_ok=True)
with open(target, 'w') as f:
    json.dump(doc, f, indent=2)
    f.write('\n')
PYEOF
  echo "  updated  $target"
}

HARNESS="${1:-all}"

run_claude() {
  echo "=== Claude ==="
  for d in "$HOME/.claude/skills" "$HOME/.claude/rules"; do
    [ -L "$d" ] && [ ! -e "$d" ] && rm "$d" && echo "  pruned  $d (broken symlink)"
  done
  mkdir -p "$HOME/.claude/skills" "$HOME/.claude/rules"
  prune "$HOME/.claude/skills"
  prune "$HOME/.claude/rules"
  while IFS= read -r skill; do
    link "$skill" "$HOME/.claude/skills/$(basename "$skill")"
  done < <(find "$AGENTS/skills" -mindepth 1 -maxdepth 1 -type d)
  for ctx in "$AGENTS/context"/*.md; do
    link "$ctx" "$HOME/.claude/rules/$(basename "$ctx")"
  done
  sync_mcp_claude
}

run_kiro() {
  echo "=== Kiro ==="
  for d in "$HOME/.kiro/skills" "$HOME/.kiro/steering"; do
    [ -L "$d" ] && [ ! -e "$d" ] && rm "$d" && echo "  pruned  $d (broken symlink)"
  done
  mkdir -p "$HOME/.kiro/skills" "$HOME/.kiro/steering"
  prune "$HOME/.kiro/skills"
  prune "$HOME/.kiro/steering"
  while IFS= read -r skill; do
    link "$skill" "$HOME/.kiro/skills/$(basename "$skill")"
  done < <(find "$AGENTS/skills" -mindepth 1 -maxdepth 1 -type d)
  for ctx in "$AGENTS/context"/*.md; do
    link "$ctx" "$HOME/.kiro/steering/$(basename "$ctx")"
  done
  sync_mcp_kiro
}

run_opencode() {
  echo "=== OpenCode ==="
  sync_mcp_opencode
}

case "$HARNESS" in
  claude)    run_claude ;;
  kiro)      run_kiro ;;
  opencode)  run_opencode ;;
  all)       run_claude; run_kiro; run_opencode ;;
  *)         echo "Usage: setup.sh [claude|kiro|opencode|all]"; exit 1 ;;
esac

echo ""
echo "Done."
